{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test"
  },
  "incremental": true,
  "mutate": ["src/**/*.ts", "!src/index.ts", "!src/tui.tsx"],
  "ignorePatterns": ["test/tui-panel.test.tsx"],
  "reporters": ["clear-text", "html", "json", "progress"],
  "allowConsoleColors": false,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  }
}
